rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Propietaria del sistema: ve el panel admin y puede bloquear usuarios.
    function esAdmin() {
      return conCuenta() && correo() in ["aliolmos19@gmail.com"];
    }

    // Cuenta de Google con correo verificado.
    function conCuenta() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function correo() {
      return request.auth.token.email.lower();
    }
    // Cuentas bloqueadas desde el Panel admin (documento config/blocked).
    function bloqueado() {
      return exists(/databases/$(database)/documents/config/blocked)
        && correo() in get(/databases/$(database)/documents/config/blocked).data.emails;
    }
    // Cualquier cuenta de Google entra, salvo las bloqueadas.
    function esPersonal() {
      return esAdmin() || (conCuenta() && !bloqueado());
    }

    match /config/blocked {
      allow read: if conCuenta();
      allow write: if esAdmin();
    }
    match /products/{id} {
      allow read, write: if esPersonal();
    }
    // Historial: cada movimiento queda firmado con el correo de quien lo hizo y no se puede editar.
    match /moves/{id} {
      allow read: if esPersonal();
      allow create: if esPersonal() && request.resource.data.by == correo();
      allow update, delete: if false;
    }
    // Último ingreso de cada usuario (lo ve la admin).
    match /sessions/{uid} {
      allow read: if esAdmin() || (esPersonal() && request.auth.uid == uid);
      allow write: if esPersonal() && request.auth.uid == uid;
    }
    // Datos del comercio que salen en los resúmenes (los edita la admin).
    match /config/business {
      allow read: if esPersonal();
      allow write: if esAdmin();
    }
    // Caja: ventas del día, deudas (fiado) y cuentas mensuales.
    match /sales/{id} {
      allow read, write: if esPersonal();
    }
    match /debts/{id} {
      allow read, write: if esPersonal();
    }
    match /accounts/{id} {
      allow read, write: if esPersonal();
    }
    match /accountEntries/{id} {
      allow read, write: if esPersonal();
    }
    match /accountMonths/{id} {
      allow read, write: if esPersonal();
    }
    // Errores que ocurren en los dispositivos de los usuarios.
    match /errors/{id} {
      allow read, delete: if esAdmin();
      allow create: if esPersonal();
    }
  }
}
